# Airlock Environment Configuration (Laptop 4 - Contoso / India)
TENANT_ID=contoso
GUARD_ID=guard-contoso-01
REGION=in
SOURCE_TZ=Asia/Kolkata

# Ports
GUARD_PORT=9000
SHOP_PORT=7000
CHAOS_PORT=9100

# Regional Ingest Endpoint (HQ ingest-in running on port 8001)
HQ_INGEST_URL=http://localhost:8001/v1/ingest
INGEST_URL=http://localhost:8001/v1/ingest

# Security Secrets (Local Tenant Secret for HMAC pseudonyms & Egress signing)
GUARD_SECRET=sec-contoso-super-secret-key-2026
GUARD_SECRET_KEY=sec-contoso-super-secret-key-2026
TENANT_KEY=tenant-contoso-key-8831
TENANT_SECRET_KEY=tenant-contoso-key-8831

# Database Paths
RAW_DB_PATH=data/raw.db
OUTBOX_DB_PATH=data/outbox.db
SHOP_LOG_PATH=data/shop-api.log

# Guard Settings
GUARD_VERSION=0.1.0
COLLECTION_INTERVAL_S=2
CANARY_INTERVAL_S=30
CHECKPOINT_INTERVAL_S=60

# Organizer Stream Adapter Settings
ORGANIZER_STREAM_PATH=data/organizer_stream.jsonl
