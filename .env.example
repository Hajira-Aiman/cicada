# Airlock Environment Configuration (Shop B - Globex / Europe)
TENANT_ID=globex
GUARD_ID=guard-globex-01
REGION=eu
SOURCE_TZ=Europe/Berlin

# Ports
GUARD_PORT=9000
SHOP_PORT=7000
CHAOS_PORT=9100

# Regional Ingest Endpoint (HQ ingest-eu running on port 8002)
HQ_INGEST_URL=http://localhost:8002/ingest

# Security Secrets (Local Tenant Secret for HMAC pseudonyms & Egress signing)
GUARD_SECRET=sec-globex-super-secret-key-2026
TENANT_KEY=tenant-globex-key-9912

# Database Paths
RAW_DB_PATH=guard/raw.db
OUTBOX_DB_PATH=guard/outbox.db
SHOP_LOG_PATH=shop-api/shop-api.log
AUTH_LOG_PATH=/var/log/auth.log

# Guard Settings
GUARD_VERSION=0.1.0
COLLECTION_INTERVAL_S=2
CANARY_INTERVAL_S=30
CHECKPOINT_INTERVAL_S=60
